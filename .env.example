# Bunny AI environment variables.
# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# IMPORTANT: NEXT_PUBLIC_* values are baked into the app at BUILD time, so set
# them before `npm run build` (on Vercel: add them in Project Settings first).

# --- AI provider (server-side only) ---
AI_PROVIDER=gemini
# Exact model ID from the provider's current model list. Not hardcoded in the
# app, so you can switch models without code changes. Check Google's model
# page (ai.google.dev/gemini-api/docs/models) for a current Flash-class model
# that is available on the free tier.
AI_MODEL=
# Create a key in Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=
# Optional: override the provider API base URL (used for local testing).
# AI_BASE_URL=

# --- Supabase (Project Settings > API) ---
# Safe for the browser: the anon/publishable key only grants what Row Level
# Security allows. The app never uses a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional defence in depth: only this email may use the app, even if
# sign-ups were ever re-enabled in Supabase.
# ALLOWED_USER_EMAIL=you@example.com
