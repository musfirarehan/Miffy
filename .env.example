# Bunny AI environment variables.
# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# All of these are read on the server only; none may use a NEXT_PUBLIC_ prefix
# except the two Supabase ones further down.

# --- AI provider (Phase 3) ---
AI_PROVIDER=gemini
# Exact model ID from the provider's current model list. Not hardcoded in the
# app, so you can switch models without code changes. Check Google's model
# page (ai.google.dev/gemini-api/docs/models) for a current Flash-class model
# that is available on the free tier.
AI_MODEL=
# Create a key in Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=
# Optional: override the provider API base URL (used for local testing).
# AI_BASE_URL=

# --- Personality (optional) ---
# gentle | balanced | savage
# BUNNY_SASS_LEVEL=balanced

# --- Supabase (Phase 4, not used yet) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses Row Level Security, so keep it off the client.
SUPABASE_SERVICE_ROLE_KEY=
