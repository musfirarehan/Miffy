# Bunny AI environment variables.
# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# Nothing here is used yet: the AI provider arrives in Phase 3, Supabase in Phase 4.

# --- AI provider (server-side only; never prefix with NEXT_PUBLIC_) ---
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses Row Level Security, so keep it off the client.
SUPABASE_SERVICE_ROLE_KEY=
